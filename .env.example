HOST=127.0.0.1
PORT=3000
NEWS_AGENT_DB_PATH=./data/news-agent.sqlite
NEWS_AGENT_DATA_ROOT=./data
WEB_ORIGIN=http://localhost:5173

# 必填：真实 LLM。Pi SDK 0.85.1 原生支持 DeepSeek；不要把真实 Key 提交到 Git。
NEWS_AGENT_MODEL_PROVIDER=deepseek
# 可选：deepseek-v4-flash（成本优先）或 deepseek-v4-pro（质量优先）
NEWS_AGENT_MODEL_ID=deepseek-v4-flash
DEEPSEEK_API_KEY=请填写

# 必填：真实网页/新闻搜索。RSS 来源不需要 API Key；动态关键词搜索使用 Tavily。
TAVILY_API_KEY=请填写

# 可选：HTTPS Webhook 推送。
NEWS_AGENT_DELIVERY_WEBHOOK_URL=

# R2 邮件推送：在 Resend 验证 mail.dailynewsagent.site 后填写。
RESEND_API_KEY=
NEWS_AGENT_EMAIL_FROM=News Agent <brief@mail.dailynewsagent.site>
# 个人 163 邮箱，仅保存在本地 .env，不要提交到 Git。
NEWS_AGENT_EMAIL_TO=
# Web 页面公开地址，用于邮件中的完整简报和签名反馈链接。
NEWS_AGENT_PUBLIC_BASE_URL=http://127.0.0.1:5173
# 至少 32 个随机字符，用于签名邮件快捷反馈链接。
NEWS_AGENT_FEEDBACK_SIGNING_SECRET=
