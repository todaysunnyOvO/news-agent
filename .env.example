HOST=127.0.0.1
PORT=3000
NEWS_AGENT_DB_PATH=./data/news-agent.sqlite
NEWS_AGENT_DATA_ROOT=./data
WEB_ORIGIN=http://localhost:5173

# 必填：真实 LLM。Pi SDK 0.85.1 原生支持 DeepSeek；不要把真实 Key 提交到 Git。
NEWS_AGENT_MODEL_PROVIDER=deepseek
# 可选：deepseek-v4-flash（成本优先）或 deepseek-v4-pro（质量优先）
NEWS_AGENT_MODEL_ID=deepseek-v4-flash
DEEPSEEK_API_KEY=请填写

# 必填：真实网页/新闻搜索。RSS 来源不需要 API Key；动态关键词搜索使用 Tavily。
TAVILY_API_KEY=请填写

# 可选：Phase 6 外部推送。使用 Webhook 时不需要邮件 API。
NEWS_AGENT_DELIVERY_WEBHOOK_URL=

# 可选：如果选择邮件推送，再填写 Resend。
RESEND_API_KEY=
NEWS_AGENT_EMAIL_FROM=
